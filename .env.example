# --------------------------------------------------
# SCOOP — tracked env template (no secrets)
# Copy values into gitignored .env.local for local work.
# --------------------------------------------------

# Supabase — public/browser-safe
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Browser / public key only. NEVER put a service-role or secret key here.
# Dashboard mapping (env var name stays NEXT_PUBLIC_SUPABASE_ANON_KEY):
#   Preferred (new keys): Project Settings → API Keys → Publishable key (sb_publishable_…)
#   Legacy still OK:      Project Settings → API Keys → Legacy → anon (JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY / SECRET
# Server/indexer elevated key. NEVER expose to the browser or NEXT_PUBLIC_*.
# Dashboard mapping (env var name stays SUPABASE_SERVICE_ROLE_KEY):
#   Preferred (new keys): Project Settings → API Keys → Secret key (sb_secret_…)
#   Legacy still OK:      Project Settings → API Keys → Legacy → service_role (JWT)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for the long-running SCOOP indexer (Render container).
# Dashboard: Connect → ORI / Connection string (also under Project Settings → Database)
#
# Preferred for Render (persistent Node worker, typically IPv4-only egress):
#   Session pooler URI — host *.pooler.supabase.com, port 5432 (Supavisor session mode).
#   Official alternative to Direct when the host cannot use IPv6 / has no IPv4 add-on.
#
# Also valid (if reachable): Direct URI — db.<project-ref>.supabase.co:5432
# Avoid for MVP indexer: Transaction pooler (port 6543) — serverless/edge oriented.
DATABASE_URL=

# Robinhood Chain — Alchemy primary
# Alchemy Dashboard → Apps → (Robinhood Chain app) → HTTPS endpoint
ROBINHOOD_RPC_URL=
# Alchemy Dashboard → Apps → (Robinhood Chain app) → WebSocket endpoint (wss://…)
ROBINHOOD_WS_URL=

# Robinhood Chain — fallback (public)
ROBINHOOD_FALLBACK_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Indexer
SCOOP_CHAIN_ID=4663
SCOOP_INDEXING_ENABLED=false
SCOOP_START_BLOCK=55863290
SCOOP_CONFIRM_MODE=safe
SCOOP_CONFIRM_LAG_BLOCKS=

# Live indexing (6A.6) — non-secret defaults
SCOOP_NEW_WINDOW_SECONDS=86400
SCOOP_SOON_THRESHOLD_BPS=8000
SCOOP_REORG_WINDOW_BLOCKS=128
SCOOP_QUOTE_SNAPSHOT_SECONDS=60
SCOOP_POLL_INTERVAL_MS=2000
SCOOP_MAX_BLOCK_BATCH=20
SCOOP_LAUNCH_DUST_RAW=1000
# Fast historical catch-up (6A.7b) — see docs/PHASE_6A_7B_FAST_CATCHUP.md
SCOOP_FAST_CATCHUP_THRESHOLD_BLOCKS=5000
SCOOP_FAST_CATCHUP_RANGE=5000
SCOOP_FAST_CATCHUP_ANCHOR_BLOCKS=64
# Optional bounded end block for catchup/once (omit for continuous)
# SCOOP_INDEX_TO_BLOCK=

# Optional runtime
LOG_LEVEL=info

# --------------------------------------------------
# Phase 6B — News Intelligence (server/worker only)
# --------------------------------------------------
# Never prefix with NEXT_PUBLIC_. Do not commit real tokens.
TIINGO_API_TOKEN=
# Bounded fresh-news ingest (6B.2) — no permanent poller yet
TIINGO_NEWS_LIMIT=100
TIINGO_NEWS_MAX_PAGES=10
# Crawl−publish lag above this marks is_backfill_candidate (default 6h)
TIINGO_BACKFILL_LAG_SECONDS=21600
# Licensing gate — keep false until Tiingo confirms redistribution/display rights
SCOOP_NEWS_PUBLIC_DISPLAY_ENABLED=false
# Future poller cadence (not enabled in 6B.2)
# TIINGO_NEWS_POLL_SECONDS=60

# OpenAI — server only (never NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_CONCEPT_MODEL=gpt-5.6-terra
# OpenAI image generation — server only
OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium
# Optional gate for POST /api/internal/*
# SCOOP_INTERNAL_API_SECRET=

# --------------------------------------------------
# Phase C — Reown identity / SIWE (product auth)
# --------------------------------------------------
# Public — Reown Cloud project id (Dashboard → Project → Project ID).
# Add your production + local origins (e.g. http://localhost:3000) under Allowed Origins.
# Note: localhost is always permitted by Reown; production origins still need allowlisting.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional — AppKit metadata.url override (no trailing slash).
# Defaults: development → http://localhost:3000 ; production → https://scoop.market
# NEXT_PUBLIC_APP_ORIGIN=

# Optional public RPC hint for AppKit custom Robinhood Chain (4663).
# Prefer the same Alchemy HTTPS endpoint as ROBINHOOD_RPC_URL (no secret in URL).
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# SERVER ONLY — HMAC secret for httpOnly scoop_session + scoop_siwe_nonce cookies.
# Generate a long random string. Never NEXT_PUBLIC_*.
SCOOP_SESSION_SECRET=

# Human Reown dashboard checklist (do not automate):
# 1) Create project at https://dashboard.reown.com
# 2) Copy Project ID → NEXT_PUBLIC_REOWN_PROJECT_ID
# 3) Allowlist localhost + production domains
# 4) Email/social embedded wallets remain OFF in product UX until C.3-proof passes

# C.3-proof ONLY — enables AppKit email feature + /dev/reown-email-proof route.
# Set to exactly 1 locally for the isolated embedded-wallet proof. Never ship as
# production Join SCOOP. Restart/rebuild after changing (NEXT_PUBLIC_*).
# NEXT_PUBLIC_SCOOP_REOWN_EMAIL_PROOF=1

# --------------------------------------------------
# Phase 6A.7 — product API / Render notes (no secrets)
# --------------------------------------------------
# Web server routes read DATABASE_URL (server-only). Never prefix with NEXT_PUBLIC_.
# Indexer continuous mode stays gated by SCOOP_INDEXING_ENABLED=false until ready.
# See docs/PHASE_6A_7_PRODUCTION_DATA_LAYER.md and docs/RENDER_INDEXER_CHECKLIST.md.
