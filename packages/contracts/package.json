{
  "name": "@scoop/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./abi/*": "./src/abi/*"
  },
  "files": [
    "dist",
    "src/abi",
    "src/manifests"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-contracts-json.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
