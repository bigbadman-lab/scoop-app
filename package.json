{
  "name": "scoop-app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:packages": "pnpm --filter @scoop/contracts run build && pnpm --filter @scoop/db run build && pnpm --filter @scoop/shared run build && pnpm --filter @scoop/news run build",
    "test": "pnpm run build:packages && pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm run build:packages && pnpm -r --if-present run typecheck",
    "dev:web": "pnpm --filter @scoop/web dev",
    "dev:indexer": "pnpm --filter @scoop/indexer^... run build && pnpm --filter @scoop/indexer dev",
    "fee-keeper:once": "pnpm --filter @scoop/fee-keeper start",
    "fee-keeper:dev": "pnpm --filter @scoop/fee-keeper dev",
    "holder-rewards:once": "pnpm --filter @scoop/holder-rewards-worker start",
    "holder-rewards:dev": "pnpm --filter @scoop/holder-rewards-worker dev",
    "format": "prettier --write .",
    "db:migrate": "node scripts/db-migrate.mjs",
    "backfill:hello": "pnpm --filter @scoop/indexer exec tsx src/commands/backfill-hello.ts",
    "verify:hello": "pnpm --filter @scoop/indexer exec tsx src/commands/verify-hello.ts",
    "reset:hello": "pnpm --filter @scoop/indexer exec tsx src/commands/reset-hello.ts",
    "reset:protocol": "pnpm --filter @scoop/indexer exec tsx src/commands/reset-protocol-cli.ts",
    "indexer:start": "pnpm --filter @scoop/indexer exec tsx src/commands/indexer-start.ts",
    "indexer:status": "pnpm --filter @scoop/indexer exec tsx src/commands/indexer-status.ts",
    "indexer:catchup": "pnpm --filter @scoop/indexer exec tsx src/commands/indexer-catchup.ts",
    "indexer:once": "pnpm --filter @scoop/indexer exec tsx src/commands/indexer-once.ts",
    "indexer:replay:token": "pnpm --filter @scoop/indexer exec tsx src/commands/indexer-replay-token.ts",
    "news:ingest:once": "pnpm --filter @scoop/news run ingest:once",
    "news:ingest": "pnpm --filter @scoop/news run ingest",
    "news:catchup": "pnpm --filter @scoop/news run catchup",
    "news:markets:dry-run": "pnpm --filter @scoop/news run markets:dry-run",
    "news:markets:simulate": "pnpm --filter @scoop/news run markets:simulate",
    "news:smoke": "pnpm --filter @scoop/news run smoke",
    "news:concepts": "pnpm --filter @scoop/news run concepts --",
    "news:draft:create": "pnpm --filter @scoop/news run draft:create --",
    "news:draft:artwork": "pnpm --filter @scoop/news run draft:artwork --",
    "images:quote-assets": "node scripts/ingest-quote-asset-images.mjs",
    "test:quote-asset-images": "vitest run scripts/quote-asset-images"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.10",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.22.0",
    "jpeg-js": "^0.4.4",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.3",
    "sharp": "^0.35.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "viem": "^2.56.3",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "overrides": {
      "@wagmi/connectors": "6.2.0",
      "@wagmi/core": "2.22.1"
    }
  }
}
