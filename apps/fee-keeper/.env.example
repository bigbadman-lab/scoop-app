# Fee Keeper — example env (NO SECRETS). Names/placeholders only.
# Default is dry-run: SCOOP_FEE_KEEPER_WRITE_ENABLED unset or false ⇒ no broadcasts.
# Write mode requires LocalAccount signing (eth_sendRawTransaction); never unlock a remote RPC account.

SCOOP_FEE_KEEPER_WRITE_ENABLED=false
SCOOP_FEE_KEEPER_CHAIN_ID=4663
SCOOP_FEE_KEEPER_ACTIVITY_LOOKBACK_MINUTES=120
SCOOP_FEE_KEEPER_FALLBACK_SWEEP_MINUTES=1440
# Must match Render cron cadence (*/15 * * * * → 15)
SCOOP_FEE_KEEPER_CRON_WINDOW_MINUTES=15

# Required for dry-run and write mode:
# ROBINHOOD_RPC_URL=
# DATABASE_URL=

# Advisory lock (prefer direct/non-pooled URL; falls back to DATABASE_URL):
# INDEXER_LOCK_DATABASE_URL=

# Required only when WRITE_ENABLED=true:
# SCOOP_FEE_KEEPER_PRIVATE_KEY=
# SCOOP_FEE_KEEPER_ADDRESS=
