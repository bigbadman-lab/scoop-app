# Holder Rewards Worker — example env (NO SECRETS).
# Default is dry-run: SCOOP_HOLDER_REWARDS_WRITE_ENABLED unset/false ⇒ no broadcasts.
# Never reuse SCOOP_FEE_KEEPER_PRIVATE_KEY.

SCOOP_HOLDER_REWARDS_WRITE_ENABLED=false
SCOOP_HOLDER_REWARDS_CHAIN_ID=4663
# fixture-test | canonical-production
# canonical-production refuses while production manifest is undeployed
SCOOP_HOLDER_REWARDS_DEPLOYMENT_MODE=fixture-test
SCOOP_HOLDER_REWARDS_MAX_ROUNDS_PER_RUN=24
SCOOP_HOLDER_REWARDS_SNAPSHOT_CONFIRMATIONS=64
SCOOP_HOLDER_REWARDS_PUSH_BATCH_SIZE=50

# Required for non-fixture runs:
# ROBINHOOD_RPC_URL=
# DATABASE_URL=
# INDEXER_LOCK_DATABASE_URL=

# Required only when WRITE_ENABLED=true (publisher + optional push signer):
# SCOOP_HOLDER_REWARDS_PUBLISHER_PRIVATE_KEY=
# SCOOP_HOLDER_REWARDS_PUBLISHER_ADDRESS=
# SCOOP_HOLDER_REWARDS_PUSH_PRIVATE_KEY=
# SCOOP_HOLDER_REWARDS_PUSH_ADDRESS=

# Future Render cron (do not deploy in P8): 5 * * * *
